# Settings for docker-compose.prod.yml: every service reads this one file.
#   cp .env.production.example .env
# then replace each CHANGE value. Never commit the filled-in copy.

APP_ENV=production

# The bundled PostgreSQL. For a managed database, remove the postgres service
# from docker-compose.prod.yml and set DATABASE_URL in this file instead.
POSTGRES_DB=pipewright
POSTGRES_USER=pipewright
POSTGRES_PASSWORD=CHANGE-a-long-random-password

# Signs sessions: openssl rand -hex 32
AUTH_JWT_SECRET=CHANGE
# Encrypts saved passwords, keys and signing secrets; without it none can be saved:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_ENCRYPTION_KEY=CHANGE
# Optional: encrypts stored files at rest (openssl rand -base64 32). Losing it loses the files.
# STORAGE_ENCRYPTION_KEY=

# The first administrator, made when Pipewright starts with no accounts.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=CHANGE-a-long-password

# Where people open Pipewright, for links in emails and embedded dashboards.
WEB_BASE_URL=https://pipewright.example.com
# Caddy is the one proxy in front of the gateway and the web.
TRUSTED_PROXY_HOPS=1
# Same host for the web and the API, so no other origin needs to call it.
BACKEND_CORS_ORIGINS=[]
# Optional: other sites that may show an embedded dashboard, separated by spaces.
# EMBED_ALLOWED_ORIGINS=https://portal.example.com
# Optional: shown under Help, Contact support.
# SUPPORT_CONTACT=support@example.com
