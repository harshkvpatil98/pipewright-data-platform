# Production-oriented template for the Next.js app.
# Copy to apps/web/.env for container or Node hosting. Never commit real secrets.
#
# Local/demo: use apps/web/.env.example instead.

NEXT_PUBLIC_APP_NAME=Pipewright

# Where the *browser* reaches the API. Built into the image: /api/v1 on the
# same host, which the Compose proxy (Caddy) and the Helm ingress send to the
# gateway. Set a full address only if the API has a host of its own, and
# rebuild the image with it.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side fetches from the web container to the gateway (Docker network hostname is typical).
API_INTERNAL_BASE_URL=http://api-gateway:8000/api/v1

NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=209715200

# Other sites that may show an embedded dashboard in a frame, separated by
# spaces. Read when each page is served, so a change needs only a restart.
# EMBED_ALLOWED_ORIGINS=https://portal.example.com https://*.partner.io

# The proxies in front of the web, as for the gateway, so a shared or embedded
# dashboard's viewers are rate limited one by one rather than all together.
TRUSTED_PROXY_HOPS=0

# Optional build labels for reviewer-facing pages (e.g. pass as Docker build-args).
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_BUILD_DATE=
