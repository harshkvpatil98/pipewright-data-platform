{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pw-dev/verification_evidence/v1",
  "title": "Verification evidence (v1)",
  "description": "Written only by the controller's runner, never by a model. Every record is bound to the exact tree it was produced against, so a later edit can invalidate it mechanically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "task_id",
    "verification_id",
    "outcome",
    "command",
    "cwd",
    "exit_status",
    "started_at",
    "finished_at",
    "duration_seconds",
    "output_digest",
    "output_bytes",
    "truncated",
    "candidate_fingerprint",
    "base_commit",
    "spec_digest",
    "environment_digest",
    "environment",
    "detail"
  ],
  "properties": {
    "schema_version": {
      "const": "verification_evidence/v1",
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "null for evidence produced against the integrated candidate rather than one task."
    },
    "verification_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "skip",
        "not_run",
        "infra_unavailable",
        "timeout",
        "error"
      ],
      "description": "'skip' means the command ran and skipped cases; 'not_run' means the command never executed; 'infra_unavailable' means a required external service was missing. None of these are 'pass'.",
      "type": "string"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "exit_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "output_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_bytes": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "candidate_fingerprint": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "spec_digest": {
      "type": "string"
    },
    "environment_digest": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "python_executable",
        "node",
        "platform",
        "resolved_modules"
      ],
      "properties": {
        "python": {
          "type": [
            "string",
            "null"
          ]
        },
        "python_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "string"
        },
        "resolved_modules": {
          "type": "array",
          "description": "Where importable modules actually resolved from. This is how an editable install pointing at another worktree is caught.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "origin"
            ],
            "properties": {
              "module": {
                "type": "string"
              },
              "origin": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
