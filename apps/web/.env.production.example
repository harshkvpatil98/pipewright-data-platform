# Production-oriented template for the Next.js app.
# Copy to apps/web/.env for container or Node hosting. Never commit real secrets.
#
# Local/demo: use apps/web/.env.example instead.

NEXT_PUBLIC_APP_NAME=Pipewright

# URL the *browser* uses to reach the gateway API (must be publicly reachable from users).
NEXT_PUBLIC_API_BASE_URL=https://api.your-app.example.com/api/v1

# Server-side fetches from the web container to the gateway (Docker network hostname is typical).
API_INTERNAL_BASE_URL=http://api-gateway:8000/api/v1

NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=26214400

# Optional build labels for reviewer-facing pages (e.g. pass as Docker build-args).
# NEXT_PUBLIC_APP_VERSION=0.2.0
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_BUILD_DATE=
