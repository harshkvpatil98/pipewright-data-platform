APP_NAME="Pipewright API Gateway"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://web:3000"]
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
AUTH_JWT_SECRET=change-this-development-only-secret-0123456789
AUTH_JWT_ISSUER=intelligent-data-platform
AUTH_JWT_AUDIENCE=intelligent-data-platform-web
AUTH_ACCESS_TOKEN_EXP_MINUTES=60

# Fernet key (url-safe base64) used to encrypt sensitive destination / BI / Slack webhook fields at rest in Postgres.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_ENCRYPTION_KEY=

STORAGE_BACKEND=local
UPLOAD_ROOT_PATH=data/uploads
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,json
PREVIEW_ROW_LIMIT=50
PROFILE_SAMPLE_VALUE_LIMIT=5

# Optional: set to a long random string to enable POST /internal/schedules/* (header X-Internal-Token).
# SCHEDULER_INTERNAL_TOKEN=

# Multi-instance / ops: stable id for this scheduler poller (hostname, pod name, or UUID per replica).
# SCHEDULER_RUNTIME_ID=
# Lease duration (seconds) for automatic schedule claims; after expiry another poller may reclaim a stalled row (30–86400).
# SCHEDULER_CLAIM_TTL_SECONDS=300

# Optional external notifications (email targets). If EXTERNAL_NOTIFICATION_SMTP_HOST is unset, email test/delivery returns a clear "not configured" message.
# EXTERNAL_NOTIFICATION_SMTP_HOST=
# EXTERNAL_NOTIFICATION_SMTP_PORT=587
# EXTERNAL_NOTIFICATION_SMTP_USER=
# EXTERNAL_NOTIFICATION_SMTP_PASSWORD=
# EXTERNAL_NOTIFICATION_SMTP_USE_TLS=true
# EXTERNAL_NOTIFICATION_SMTP_FROM=noreply@example.com
