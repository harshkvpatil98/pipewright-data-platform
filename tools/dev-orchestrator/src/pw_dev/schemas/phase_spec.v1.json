{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pw-dev/phase_spec/v1",
  "title": "Phase specification (v1)",
  "description": "The planner's contract with the controller. Everything the controller schedules, verifies and publishes is derived from this document. Authored in the subset of JSON Schema that both `codex exec --output-schema` and `claude --json-schema` accept in strict mode: every property is required and every object forbids extra keys; optionality is expressed with a null union.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "phase_title",
    "summary",
    "base_commit",
    "source_references",
    "requirements",
    "non_goals",
    "invariants",
    "public_contracts",
    "migration_strategy",
    "tasks",
    "acceptance_criteria",
    "required_verifications",
    "accepted_preexisting_failures",
    "risks",
    "resource_limits",
    "publication_policy",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "phase_spec/v1",
      "type": "string"
    },
    "phase_id": {
      "type": "string",
      "description": "Stable identifier, e.g. '18' or '18-time-travel'."
    },
    "phase_title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "What this phase delivers, in a few sentences."
    },
    "base_commit": {
      "type": "string",
      "description": "Full 40-character SHA the plan was written against."
    },
    "source_references": {
      "type": "array",
      "description": "Repository evidence the plan rests on. Every claim about existing behaviour should cite one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "lines",
          "why"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "lines": {
            "type": [
              "string",
              "null"
            ],
            "description": "e.g. '120-180', or null for a whole-file reference."
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "rationale",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable ID such as R-01. Referenced by tasks, reviews and evidence."
          },
          "statement": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should"
            ],
            "type": "string"
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "description": "Architectural rules the change must not break. Violating one is a blocking review finding.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "description": "Where in the repository this rule is already enforced."
          }
        }
      }
    },
    "public_contracts": {
      "type": "array",
      "description": "Schemas, routes and shared types this phase adds or changes. Changing one of these later requires a specification amendment.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "path",
          "change",
          "breaking"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "http_route",
              "python_schema",
              "typescript_type",
              "database_table",
              "cli",
              "event",
              "other"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "change": {
            "enum": [
              "add",
              "modify",
              "remove"
            ],
            "type": "string"
          },
          "breaking": {
            "type": "boolean"
          }
        }
      }
    },
    "migration_strategy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "needed",
        "notes",
        "alembic_revisions"
      ],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "alembic_revisions": {
          "type": "array",
          "description": "Revision slugs this phase expects to allocate. Allocation is serialized by the controller.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "The task DAG. Dependencies are scheduled by the controller; write ownership must not overlap between concurrently eligible tasks.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "role",
          "objective",
          "depends_on",
          "requirement_ids",
          "allowed_paths",
          "forbidden_paths",
          "exclusive_resources",
          "acceptance_criteria",
          "verification_ids",
          "context_paths",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable ID such as T-01."
          },
          "title": {
            "type": "string"
          },
          "role": {
            "enum": [
              "contract",
              "backend",
              "frontend",
              "verification",
              "integration",
              "docs"
            ],
            "description": "'contract' work is serialized ahead of everything that depends on it. 'verification' is a checkpoint: the controller runs this task's verification_ids against the integrated candidate and refuses to release its dependents until every one passes. A verification task that declares no allowed_paths is executed entirely by the controller, with no worker.",
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_paths": {
            "type": "array",
            "description": "Repository-relative glob patterns this task may write. Anything else is rejected at integration. A pattern is a glob only if it contains '*' or '?'; '[' and ']' are literal, so a Next.js dynamic route directory is written as it appears on disk. May be empty ONLY for role 'verification', which then becomes a controller-executed checkpoint: no worker is dispatched, and the controller runs verification_ids against the integrated candidate.",
            "items": {
              "type": "string"
            }
          },
          "forbidden_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusive_resources": {
            "type": "array",
            "description": "Named locks serialized across the run, e.g. 'alembic', 'lockfile:package-lock.json', 'contract:shared-types'.",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_ids": {
            "type": "array",
            "description": "Registry IDs the controller runs for this task. The worker cannot invent new ones. For an ordinary task these are advisory evidence. For a 'verification' task they are the checkpoint: every one must pass, against the integrated candidate, before any dependent task starts.",
            "items": {
              "type": "string"
            }
          },
          "context_paths": {
            "type": "array",
            "description": "Files the controller should put in front of the worker. Keep this small and task-relevant.",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Phase-level criteria, each traceable to requirement IDs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "requirement_ids",
          "verification_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "required_verifications": {
      "type": "array",
      "description": "Verification registry IDs that must pass on the integrated candidate before COMMIT.",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "risk",
          "severity",
          "mitigation",
          "test_idea"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          },
          "test_idea": {
            "type": "string"
          }
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel_workers",
        "per_task_seconds",
        "total_run_seconds",
        "repair_rounds_per_task"
      ],
      "properties": {
        "max_parallel_workers": {
          "type": "integer"
        },
        "per_task_seconds": {
          "type": "integer"
        },
        "total_run_seconds": {
          "type": "integer"
        },
        "repair_rounds_per_task": {
          "type": "integer"
        }
      }
    },
    "publication_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "branch_prefix",
        "allow_existing_branch"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "local_commit",
            "feature_branch"
          ],
          "type": "string"
        },
        "branch_prefix": {
          "type": "string"
        },
        "allow_existing_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "Contradictions found in the repository and how the plan resolves them. Empty is a claim, not a default.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "evidence",
          "resolution"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "accepted_preexisting_failures": {
      "type": "array",
      "description": "Checks that are already not passing before this phase begins, which this phase deliberately does not fix. Listing one here is the only way a pre-existing failure stops blocking completion -- it must be stated, with a reason, rather than absorbed silently. A check that this run breaks is never covered by this list.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verification_id",
          "reason"
        ],
        "properties": {
          "verification_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
