        <MetaInfo connection="Output">
          <RecordInfo>
            <Field name="order_id" type="Int32" size="4" />
            <Field name="customer" type="V_String" size="254" />
            <Field name="region" type="V_String" size="254" />
            <Field name="amount" type="Double" size="8" />
            <Field name="status" type="V_String" size="254" />
            <Field name="order_date" type="Date" size="10" />
          </RecordInfo>
        </MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxDbFileInput" />
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput"><Position x="54" y="246" /></GuiSettings>
      <Properties>
        <Configuration>
          <NumRows value="3" />
          <Fields><Field name="region" /><Field name="manager" /></Fields>
          <Data>
            <r><c>North</c><c>Nia</c></r>
            <r><c>South</c><c>Sol</c></r>
            <r><c>East</c><c>Eve</c></r>
          </Data>
        </Configuration>
        <MetaInfo connection="Output">
          <RecordInfo><Field name="region" type="V_String" size="5" /><Field name="manager" type="V_String" size="3" /></RecordInfo>
        </MetaInfo>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTextInput" />
    </Node>
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter"><Position x="150" y="114" /></GuiSettings>
      <Properties>
        <Configuration>
          <Expression>[status] != "test" AND [amount] &gt; 0</Expression>
          <Mode>Custom</Mode>
        </Configuration>
      </Properties>
    </Node>
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="246" y="114" /></GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="Uppercase(Trim([customer]))" field="customer" size="254" type="V_String" />
            <FormulaField expression="[amount] * 1.2" field="amount_with_tax" size="8" type="Double" />
            <FormulaField expression="[region] + &quot;/&quot; + [customer]" field="label" size="254" type="V_String" />
            <FormulaField expression="IIF([amount] &gt;= 100, &quot;large&quot;, &quot;small&quot;)" field="size" size="5" type="V_String" />
            <FormulaField expression="IF [status] = &quot;refund&quot; THEN -[amount] ELSEIF IsNull([region]) THEN 0 ELSE [amount] ENDIF" field="net" size="8" type="Double" />
            <FormulaField expression="Contains([customer], &quot;AN&quot;)" field="named_an" size="1" type="Bool" />
          </FormulaFields>
        </Configuration>
      </Properties>
    </Node>
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Join.Join"><Position x="342" y="174" /></GuiSettings>
      <Properties>
        <Configuration joinByRecordPos="False">
          <JoinInfo connection="Left"><Field field="region" /></JoinInfo>
          <JoinInfo connection="Right"><Field field="region" /></JoinInfo>
          <SelectConfiguration>
            <Configuration outputConnection="Join">
              <OrderChanged value="False" />
              <SelectFields>
                <SelectField field="Right_region" selected="False" input="Right_" />
                <SelectField field="manager" selected="True" rename="region_manager" input="Right_" />
                <SelectField field="*Unknown" selected="True" />
              </SelectFields>
            </Configuration>
          </SelectConfiguration>
        </Configuration>
      </Properties>
    </Node>
