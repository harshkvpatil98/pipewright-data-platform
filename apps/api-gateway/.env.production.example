# Production-oriented template for the API gateway.
# Copy to apps/api-gateway/.env (or inject via your orchestrator). Never commit real secrets.
#
# Local/demo: use apps/api-gateway/.env.example instead.

APP_NAME="Pipewright API Gateway"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Browser origins allowed to call the API (JSON array). Use your real web origin(s).
BACKEND_CORS_ORIGINS=["https://your-app.example.com"]

# Strong unique values in real deployments.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db-host:5432/DBNAME
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_JWT_ISSUER=intelligent-data-platform
AUTH_JWT_AUDIENCE=intelligent-data-platform-web
AUTH_ACCESS_TOKEN_EXP_MINUTES=60

# Required in production: Fernet symmetric key for encrypting sensitive saved configs (DB passwords, BI secrets, Slack webhooks).
# Generate once per deployment: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key invalidates existing encrypted fields until you re-save configs or run a data migration.
APP_SECRET_ENCRYPTION_KEY=replace-with-fernet-key

# Storage: local paths are fine for single-node; use shared/object storage for multi-instance.
STORAGE_BACKEND=local
UPLOAD_ROOT_PATH=/var/lib/platform/uploads
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,json
PREVIEW_ROW_LIMIT=50
PROFILE_SAMPLE_VALUE_LIMIT=5

# Optional: enables POST /internal/schedules/* when set. Use a long random token; pass via X-Internal-Token.
# SCHEDULER_INTERNAL_TOKEN=

# Recommended when more than one process polls due schedules: unique per replica (e.g. Kubernetes pod name).
# SCHEDULER_RUNTIME_ID=
# Automatic-run claim lease in seconds (30–86400). Tune for longest expected schedule execution.
# SCHEDULER_CLAIM_TTL_SECONDS=300
