{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pw-dev/worker_report/v1",
  "title": "Worker report (v1)",
  "description": "What an implementation worker returns. `tests_claimed` is explicitly a claim: the controller re-runs the registry IDs itself and records separate evidence. A schema-valid report is not verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "summary",
    "changed_paths",
    "requirement_ids_addressed",
    "tests_claimed",
    "verification_requests",
    "assumptions",
    "blockers",
    "proposed_improvements"
  ],
  "properties": {
    "schema_version": {
      "const": "worker_report/v1",
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "refused"
      ],
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_ids_addressed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_claimed": {
      "type": "array",
      "description": "Tests the worker says it ran. Recorded as a claim and compared against runner evidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "claimed_outcome"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "claimed_outcome": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ],
            "type": "string"
          }
        }
      }
    },
    "verification_requests": {
      "type": "array",
      "description": "Registry IDs the worker asks the controller to execute. Unknown IDs are rejected, never executed.",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "in_scope",
          "reason"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "in_scope": {
            "type": "boolean",
            "description": "true only when it reduces a concrete risk inside the accepted scope; otherwise it goes to the backlog."
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
