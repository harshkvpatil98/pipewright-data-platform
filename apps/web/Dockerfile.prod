# Production-oriented Next.js image (standalone monorepo workspace build).
# Build args bake NEXT_PUBLIC_* at build time.

FROM node:22-alpine

WORKDIR /repo

ARG NEXT_PUBLIC_APP_NAME=Pipewright
# Relative by default: the Compose proxy and the Helm ingress both send /api
# to the gateway on the same host, so one image works behind either. Set an
# absolute address only when the API is on another host.
ARG NEXT_PUBLIC_API_BASE_URL=/api/v1
ARG NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=209715200

ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES=$NEXT_PUBLIC_MAX_UPLOAD_SIZE_BYTES
ENV NODE_ENV=production

COPY package.json package-lock.json /repo/
COPY apps/web/package.json /repo/apps/web/
COPY packages/shared-types/package.json /repo/packages/shared-types/
COPY packages/shared-ui/package.json /repo/packages/shared-ui/
COPY packages/config/package.json /repo/packages/config/

# The build needs the dev dependencies (Tailwind, TypeScript); with
# NODE_ENV=production set above, npm ci would leave them out and `next build`
# fails to find @tailwindcss/postcss.
RUN npm ci --include=dev

COPY apps/web /repo/apps/web
COPY packages /repo/packages
# The help pages (/help) are read from docs/user, so they match this build.
COPY docs/user /repo/docs/user

RUN npm run build --workspace @platform/web

EXPOSE 3000

# Listen on all interfaces inside the container (same flags as `next start --help`).
CMD ["npm", "run", "start", "--workspace", "@platform/web", "--", "--hostname", "0.0.0.0", "--port", "3000"]
