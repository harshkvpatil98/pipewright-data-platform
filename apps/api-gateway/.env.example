APP_NAME="Pipewright API Gateway"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://web:3000"]
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
AUTH_JWT_SECRET=change-this-development-only-secret-0123456789
AUTH_JWT_ISSUER=intelligent-data-platform
AUTH_JWT_AUDIENCE=intelligent-data-platform-web
AUTH_ACCESS_TOKEN_EXP_MINUTES=60
# A session renews itself while in use, up to this many hours after signing in.
AUTH_SESSION_MAX_HOURS=12

# Fernet key (url-safe base64) used to encrypt sensitive destination / BI / Slack webhook fields at rest in Postgres.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_ENCRYPTION_KEY=

STORAGE_BACKEND=local
UPLOAD_ROOT_PATH=data/uploads
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,json
PREVIEW_ROW_LIMIT=50
PROFILE_SAMPLE_VALUE_LIMIT=5

# Optional: set to a long random string to enable POST /internal/schedules/* (header X-Internal-Token).
# SCHEDULER_INTERNAL_TOKEN=

# Multi-instance / ops: stable id for this scheduler poller (hostname, pod name, or UUID per replica).
# SCHEDULER_RUNTIME_ID=
# Lease duration (seconds) for automatic schedule claims; after expiry another poller may reclaim a stalled row (30–86400).
# SCHEDULER_CLAIM_TTL_SECONDS=300

# Optional external notifications (email targets). If EXTERNAL_NOTIFICATION_SMTP_HOST is unset, email test/delivery returns a clear "not configured" message.
# EXTERNAL_NOTIFICATION_SMTP_HOST=
# EXTERNAL_NOTIFICATION_SMTP_PORT=587
# EXTERNAL_NOTIFICATION_SMTP_USER=
# EXTERNAL_NOTIFICATION_SMTP_PASSWORD=
# EXTERNAL_NOTIFICATION_SMTP_USE_TLS=true
# EXTERNAL_NOTIFICATION_SMTP_FROM=noreply@example.com

# Connectors that call web addresses never call cloud metadata (169.254.x.x).
# This machine (127.0.0.1) is refused unless allowed; private networks are
# allowed unless blocked.
OUTBOUND_ALLOW_LOOPBACK=false
OUTBOUND_BLOCK_PRIVATE_NETWORKS=false
# Folder that "Server files" sources and server-folder destinations may use.
SERVER_FILES_ROOT=data/server-files

# Stored files (uploads, datasets, versions) are encrypted with AES-256 when
# this is set. Make one with `openssl rand -base64 32`, keep it with your other
# secrets, and run `platform-encrypt-storage` once to encrypt files saved
# before it was set. Losing the key loses the files.
# STORAGE_ENCRYPTION_KEY=
# How many proxies sit in front of the gateway. Only then is X-Forwarded-For
# trusted, so organisation network lists see each person's real address.
TRUSTED_PROXY_HOPS=0
# Shown under Help, Contact support: an email address or a web address.
# SUPPORT_CONTACT=support@example.com
# Where stored files live: "local" (this machine's disk, UPLOAD_ROOT_PATH) or
# "s3" (an S3-compatible bucket: AWS S3, MinIO, R2...), so every gateway and
# worker reads the same files. Leave the keys empty to use an instance role.
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=pipewright-files
# STORAGE_S3_PREFIX=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
